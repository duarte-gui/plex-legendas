# Copie para .env e preencha. O .env é ignorado pelo git.

# --- Plex (obrigatório) ---
# O token está em Preferences.xml, campo PlexOnlineToken, ou pode ser obtido
# em qualquer requisição autenticada da interface web do Plex.
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=

# Idioma no formato que o Plex espera: pt-BR, es-ES, fr-FR, en-US...
# Atenção: códigos de três letras (por, pob) fazem o servidor responder HTTP 500.
IDIOMA=pt-BR

# Descarta candidatos abaixo deste score. Correspondências corretas costumam
# passar de 1000; as espúrias raramente chegam a algumas centenas.
SCORE_MIN=1000

PORTA=8770

# --- Bazarr (opcional: só para exportar as legendas como arquivo) ---
BAZARR_URL=http://bazarr.local:6767
BAZARR_APIKEY=

# --- Acesso ao banco do Plex (opcional: necessário para exportar) ---
PLEX_DB_DIR=/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Plug-in Support/Databases
PLEX_SQLITE=/usr/lib/plexmediaserver/Plex SQLite

# Se o Plex roda em outra máquina, informe o destino SSH:
# PLEX_SSH=usuario@servidor-plex
# Se roda em contêiner, um prefixo para executar lá dentro:
# PLEX_CMD_PREFIXO=docker exec plex
